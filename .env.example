# TrueForge harness location (local mode default)
TRUEFORGE_BASE_URL=http://localhost:8790

# Project name written into PROJECT.ctx
DISTIL_PROJECT_NAME=demo-project

# OpenAI-compatible endpoint for `distil digest` (chat completions).
# Any provider that speaks the OpenAI chat-completions API works.
DISTIL_LLM_BASE_URL=https://api.openai.com/v1
DISTIL_LLM_API_KEY=
DISTIL_LLM_MODEL=gpt-4o-mini
